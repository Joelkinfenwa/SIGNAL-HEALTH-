# Copy to .env.local for local development. On Vercel, set these per environment.
# PRODUCTION CHECKLIST: every variable below marked (prod) must be set on Production before launch.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://signal.example.com            # (prod) used in emails and order links

# --- Stripe (test keys on Preview, live keys on Production only) ---
STRIPE_SECRET_KEY=sk_live_...                               # (prod)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...              # (prod)
STRIPE_WEBHOOK_SECRET=whsec_...                             # (prod) from the endpoint registered at <site>/api/stripe/webhook
ORDER_TOKEN_SECRET=                                         # (prod) long random string; signs order confirmation links

# --- Email (Resend) ---
RESEND_API_KEY=re_...                                       # (prod) order confirmations; without it, sends are logged and skipped
OPS_ALERT_EMAIL=                                            # (prod) where to email when a paid order's request form cannot be issued
ORDER_NOTIFY_EMAIL=                                         # (prod) internal copy of every paid order with the request form attached; falls back to OPS_ALERT_EMAIL
EMAIL_FROM="SIGNAL by Express Pathology <orders@your-verified-domain>"   # (prod) domain must be verified in Resend
EMAIL_REPLY_TO=express@expresspathology.com.au            # (prod) where customer replies land when the sending domain has no inbox

# --- Booking ---
NEXT_PUBLIC_BOOKING_URL=                                    # (prod) Express Pathology booking link; ?ref=<order id> is appended

# --- Analytics and ads ---
NEXT_PUBLIC_GA4_ID=G-XXXXXXX                                # (prod) GA4 measurement id
GA4_API_SECRET=                                             # (prod) GA4 Measurement Protocol secret (Admin → Data streams → MP API secrets)
NEXT_PUBLIC_META_PIXEL_ID=                                  # (prod) Meta Pixel id
META_CAPI_ACCESS_TOKEN=                                     # (prod) Conversions API token (Events Manager → Settings)
NEXT_PUBLIC_TRYBE_PIXEL_CODE=                                # (prod) Trybe creator-attribution pixel code (px_...); store id and track domain are in src/config/trybe.ts
META_TEST_EVENT_CODE=                                       # optional, Preview only: shows events in Meta's Test Events tab
NEXT_PUBLIC_SERVER_EVENTS=                                  # set 0 to stop the browser mirroring events to /api/events

# --- Pricing ---
NEXT_PUBLIC_PREVIEW_PRICING=                                # leave unset everywhere now that all prices are set
