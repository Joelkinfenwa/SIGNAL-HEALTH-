# Copy to .env.local for local development. On Vercel, set these per environment.

# --- Stripe (test keys on Preview, live keys on Production only) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the webhook endpoint you register at <site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Signs order confirmation links. Any long random string; different per environment.
ORDER_TOKEN_SECRET=

# --- Pricing ---
# Placeholder prices so payments can be tested before pricing is set.
# Set to 1 on the Vercel PREVIEW environment only. Never on Production.
NEXT_PUBLIC_PREVIEW_PRICING=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://signal.example.com
# Mirror browser events to /api/events (phase 7)
NEXT_PUBLIC_SERVER_EVENTS=
